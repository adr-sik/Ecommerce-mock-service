@using Client.Services
@using Shared.Models
@using Shared.Models.DTOs
@inject CartService cartService;

@page "/cart"


<h3>Cart</h3>
<MudButton OnClick="HandleGet">Get Cart</MudButton>
<MudButton OnClick="HandleAdd">Add Random Item</MudButton>
<MudButton OnClick="HandleCheckout">Checkout</MudButton>
<MudButton OnClick="LoadCart">Show Items</MudButton>

@if (!isLoading)
{
	<h3>Total: @CalculateTotal()</h3>

	foreach (ProductDTO product in productsToDisplay)
	{
		<MudPaper Width="100%" Class="border-double border-4 mud-border-primary pa-4 mt-4">
			<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
				<MudImage Src="@product.Images?.FirstOrDefault()?.Path" Alt="Product Image" Width="200"/>
				<MudStack>
					<h5>Price: @product.GetFinalPrice()</h5>
					<h5>Quantity: @checkoutItems.Where(item => item.ProductId == product.Id).FirstOrDefault()?.Quantity</h5>
				</MudStack>
			</MudStack>
			<h5>ProductId: @product.Id Name: @product.Brand @product.Model Price: @product.Price</h5>
		</MudPaper>
	}
}

@code {
	private List<CheckoutItemDTO> checkoutItems = new List<CheckoutItemDTO>();
	private Random rnd = new Random();
	private List<ProductDTO> productsToDisplay = new List<ProductDTO>();
	private bool isLoading = true;

	protected override async Task OnParametersSetAsync()
	{
		checkoutItems = await cartService.GetCart();
		await LoadCart();
		isLoading = false;
	}

	private async Task HandleGet()
	{
		checkoutItems = await cartService.GetCart();
	}

	private async Task HandleAdd()
	{		
		await cartService.UpdateCart(rnd.Next(5), rnd.Next(5));
		checkoutItems = await cartService.GetCart();
	}

	private async Task HandleCheckout()
	{
		var result = await cartService.ProceedToCheckout();

		if(result == true)
		{
			await cartService.DeleteCart();
		}
	}

	private async Task LoadCart()
	{
		if (checkoutItems.Count == 0)
			return;

		var result = await cartService.LoadCartItems(checkoutItems);

		if (result == null || result.Count == 0)
		{
			return;
		}

		productsToDisplay = result;
	}

	private decimal CalculateTotal()
	{
		return cartService.CalculateTotalPrice(checkoutItems, productsToDisplay);
	}
}
